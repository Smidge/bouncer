# bouncer as a system service with its own user (Linux), with privilege separation.
#
# The service starts as root only long enough to:
#   - fork a small attribution helper that keeps CAP_SYS_PTRACE and CAP_DAC_READ_SEARCH (to
#     read callers' /proc/<pid>/environ) and nothing else, running as the bouncer user;
#   - read the vault key from an encrypted systemd credential (and any sink or admission
#     credentials listed below);
#   - hand /run/bouncer to the bouncer user.
# The daemon then drops to `bouncer` with no capabilities and no way back to root.
# `user = "bouncer"` in the config turns this on. See "Dedicated-user mode" in the README for
# the setup steps and a matching config.

[Unit]
Description=bouncer secret store for agents
Documentation=https://github.com/Smidge/bouncer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=BOUNCER_CONFIG=/etc/bouncer/config.toml
ExecStart=/usr/local/bin/bouncer serve
Restart=on-failure
RestartSec=2

# The vault key, encrypted with the host key (and sealed to the TPM when there is one):
#   bouncer keygen | sudo systemd-creds encrypt --name=bouncer-key - /etc/credstore.encrypted/bouncer-key
# and key_credential = "bouncer-key" in the config.
LoadCredentialEncrypted=bouncer-key:/etc/credstore.encrypted/bouncer-key
# Sink or admission credentials, referenced as *_credential = "<name>" in the config:
#LoadCredentialEncrypted=s3-secret:/etc/credstore.encrypted/s3-secret

RuntimeDirectory=bouncer
RuntimeDirectoryMode=0710
UMask=0077

# Only what the start-up phase needs; the daemon itself ends with none of these.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_SETPCAP CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=
NoNewPrivileges=yes
LimitCORE=0
LimitMEMLOCK=infinity

ProtectSystem=strict
ReadWritePaths=/var/lib/bouncer
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
