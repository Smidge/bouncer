# bouncer as a system service with its own user (Linux).
#
# The daemon runs as `bouncer`, so agents running as your login user cannot read the
# vault or key files directly. CAP_SYS_PTRACE lets it read /proc/<pid>/environ of callers
# owned by other users, which it needs for context attribution.
#
# Setup:
#   sudo useradd --system --home-dir /var/lib/bouncer --shell /usr/sbin/nologin bouncer
#   sudo install -m 0755 bouncer /usr/local/bin/bouncer
#   sudo install -d -o bouncer -g bouncer -m 0700 /etc/bouncer /var/lib/bouncer
#   sudo install -o bouncer -g bouncer -m 0600 config.toml /etc/bouncer/config.toml
#   sudo -u bouncer env BOUNCER_CONFIG=/etc/bouncer/config.toml bouncer init
#   sudo install -m 0644 contrib/bouncer.service /etc/systemd/system/bouncer.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now bouncer
#
# /etc/bouncer/config.toml for this unit (replace 1000 with your uid, from `id -u`):
#   socket = "/run/bouncer/bouncer.sock"
#   socket_mode = "0666"
#   allowed_uids = [1000]
#   key = "/etc/bouncer/key"
#   vault = "/var/lib/bouncer/vault.bin"
#   audit_log = "/var/lib/bouncer/audit.jsonl"
#
# Clients then need: export BOUNCER_SOCKET=/run/bouncer/bouncer.sock

[Unit]
Description=bouncer secret store for agents
Documentation=https://github.com/Smidge/bouncer
After=network-online.target
Wants=network-online.target

[Service]
User=bouncer
Group=bouncer
Environment=BOUNCER_CONFIG=/etc/bouncer/config.toml
ExecStart=/usr/local/bin/bouncer serve
AmbientCapabilities=CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_SYS_PTRACE
NoNewPrivileges=yes
RuntimeDirectory=bouncer
RuntimeDirectoryMode=0755
UMask=0077
ProtectSystem=strict
ReadWritePaths=/var/lib/bouncer
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
